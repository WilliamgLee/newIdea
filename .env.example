# Salin file ini menjadi `.env` lalu isi bila perlu. File `.env` TIDAK di-commit.

# Opsional: API key Gemini free tier (hanya dipakai jika llm.provider = "gemini")
GEMINI_API_KEY=

# Kunci rahasia untuk menandatangani cookie sesi (dipakai mulai M6).
# Isi dengan string acak panjang, mis. hasil:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_OFFICE_SECRET_KEY=

# Opsional: path config alternatif
# AI_OFFICE_CONFIG=config.yaml
